{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["clusterName", "repoURL", "targetRevision", "gitopsNamespace"],
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "repoURL": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "gitopsNamespace": {
      "type": "string",
      "minLength": 1
    },
    "applicationSet": {
      "type": "object",
      "properties": {
        "requeueAfterSeconds": {
          "type": "integer",
          "minimum": 15
        },
        "preserveResourcesOnDeletion": {
          "type": "boolean"
        }
      }
    }
  }
}
